# ==============================================================================
# All-in-One AI Hub &mdash; Environment Configuration Template
# ==============================================================================
# Instructions:
# 1. Copy this file to '.env.local':
#    PowerShell: Copy-Item .env.example .env.local
#    Bash:       cp .env.example .env.local
# 2. Add your developer API credentials below.
# 3. Never commit '.env.local' or live API keys to version control.
#
# IMPORTANT BILLING NOTICE:
# Developer API access and token billing are completely SEPARATE from consumer
# chat subscriptions (e.g. ChatGPT Plus, Claude Pro, or Gemini Advanced).
# You must obtain API keys from the developer consoles below with pay-as-you-go
# or free tier credits configured.
# ==============================================================================

# --- OpenAI Configuration ---
# Console: https://platform.openai.com/api-keys
# Supported Models: gpt-4o, gpt-4o-mini, o3-mini
OPENAI_API_KEY=your_openai_api_key_here

# --- Anthropic Claude Configuration ---
# Console: https://console.anthropic.com/settings/keys
# Supported Models: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, claude-3-opus-20240229
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Google Gemini Configuration ---
# Console: https://aistudio.google.com/app/apikey
# Supported Models: gemini-1.5-pro, gemini-1.5-flash, gemini-2.0-flash
GEMINI_API_KEY=your_gemini_api_key_here

# --- Supabase Configuration (Optional - Remote Persistence & Auth) ---
# Create a free project at https://supabase.com
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# --- Application Configuration ---
# Set to 'true' to force mock mode regardless of server API keys
NEXT_PUBLIC_FORCE_MOCK=false
